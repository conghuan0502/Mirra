---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/eiyuumiru/Mirra';
const dmg = `${repo}/releases/latest`;

// Hard extruded depth for the display type, built as a stack of 1px steps. --d scales the depth per
// letter (0 flat, 1 full), so letters can be stamped flat and rise, or be pressed back into the page.
const extrude = Array.from({ length: 24 }, (_, i) => `calc(${i + 1} * var(--sx, 0.0042em) * var(--d)) calc(${i + 1} * var(--sy, 0.0042em) * var(--d)) 0 #0f2a47`).join(',');

// Display words split into letters; spaces stay as text between words so they keep their width.
const letters = (text: string) => text.split(' ').map((w) => [...w]);

const steps = [
  { id: 'mac', label: 'Your Mac', text: 'Mirra runs on your Intel Hackintosh and keeps the bridge connection alive in the background.' },
  { id: 'bridge', label: 'Bridge iPhone', text: 'A separate jailbroken iPhone returns the cryptographic operations Apple’s app asks for, over SSH on Wi-Fi or USB.' },
  { id: 'app', label: 'iPhone Mirroring', text: 'Apple’s own iPhone Mirroring app provides the screen, keyboard, pointer and authentication.' },
  { id: 'phone', label: 'Your iPhone', text: 'The iPhone you mirror needs no jailbreak. Keep it locked and nearby with Wi-Fi and Bluetooth on.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mirra: iPhone Mirroring on Hackintosh</title>
    <meta
      name="description"
      content="Mirra is an experimental, independent macOS companion that prepares a separate jailbroken iPhone as a bridge so Apple's iPhone Mirroring can run on an Intel Hackintosh."
    />
    <meta name="theme-color" content="#1e40af" />
    <link rel="icon" type="image/png" href={`${base}/img/icon.png`} />
    <style is:inline set:html={`.display__char{text-shadow:${extrude}}`}></style>
  </head>
  <body>
    <div class="cursor" aria-hidden="true" data-cursor></div>
    <div class="cursor__dot" aria-hidden="true" data-cursor-dot></div>
    <a class="skip" href="#main">Skip to main content</a>
    <div class="page">
      <p class="notice">Experimental. Independent community project, not affiliated with Apple.</p>
      <header class="nav">
        <a class="brand" href={`${base}/`} aria-label="Mirra home">
          <span class="brand__name"><img src={`${base}/img/icon.png`} alt="" width="26" height="26" />MIRRA</span>
          <span class="tag">Experimental</span>
        </a>
        <nav class="links" aria-label="Project">
          <a class="pill" href={`${repo}/tree/main/docs`}>Docs</a>
          <a class="pill" href={`${repo}#compatibility`}>Compatibility</a>
          <a class="pill" href={repo}>Source</a>
        </nav>
        <a class="pill pill--solid" href="https://ko-fi.com/eiyuumiru"><span class="hide-sm">Support on </span>Ko-fi</a>
      </header>

      <main class="hero" id="main">
        <div class="stage" data-stage>
          <!-- drawn from the laptop to the "Your Mac" stop; the path is laid out in script -->
          <svg class="arrow arrow--route" aria-hidden="true" data-arrow>
            <path pathLength="100" data-arrow-shaft></path>
            <path pathLength="100" data-arrow-head></path>
          </svg>
          <div class="type">
            <h1 class="display" aria-label="Your iPhone. On your Hackintosh.">
              {[['a', 'Your iPhone.'], ['b', 'On your'], ['c', 'Hackintosh.']].map(([key, text]) => (
                <span class={`display__line display__line--${key}`} aria-hidden="true">
                  {key === 'b' ? (
                    <span class="display__inner"><span class="display__sticker" data-sticker>{text}</span></span>
                  ) : (
                    <span class="display__inner" data-line={key}>
                      {letters(text).map((word, i) => (
                        <>{i > 0 && ' '}<span class="display__word">{word.map((c) => <span class="display__char">{c}</span>)}</span></>
                      ))}
                    </span>
                  )}
                </span>
              ))}
            </h1>

            <div class="float float--mac" data-float>
              <button
                class="card card--mac"
                type="button"
                aria-pressed="false"
                aria-label="Your Mac — Intel Hackintosh, macOS 26.7.2. Tap to see its role"
                data-card="mac"
              >
                <span class="card__media">
                  <img src={`${base}/img/card-mac.webp`} alt="" width="480" height="326" decoding="async" />
                </span>
              </button>
            </div>

            <div class="float float--bridge" data-float>
              <button
                class="card card--bridge"
                type="button"
                aria-pressed="false"
                aria-label="Bridge iPhone — Jailbroken, OpenSSH and ldid. Tap to see its role"
                data-card="bridge"
              >
                <span class="card__media">
                  <img src={`${base}/img/card-bridge.webp`} alt="" width="336" height="412" decoding="async" />
                </span>
              </button>
            </div>

            <a class="badge" href={dmg} aria-label="Get the latest Mirra DMG from GitHub Releases" data-badge>
              <svg class="badge__ring" viewBox="0 0 100 100" aria-hidden="true">
                <path id="ring" d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none"></path>
                <text><textPath href="#ring" textLength="228" lengthAdjust="spacing">Get the latest DMG • Free • MIT • </textPath></text>
              </svg>
              <svg class="badge__icon" viewBox="0 0 100 100" aria-hidden="true">
                <g class="badge__drop">
                  <path d="M50,15 V70"></path>
                  <path d="M28,50 L50,72 L72,50"></path>
                </g>
                <path d="M22,86 H78"></path>
              </svg>
            </a>
          </div>

          <p class="lede">
            Mirra lets Apple&rsquo;s iPhone Mirroring run on a Hackintosh. A separate jailbroken iPhone is the bridge, and the
            iPhone you mirror stays stock.
          </p>

          <div class="route" data-route>
            <div class="route__track" data-track>
              <span class="route__wire" aria-hidden="true" data-wire><span class="route__lit"></span><span class="route__spark" data-spark></span></span>
              <div class="route__tabs" role="tablist" aria-label="How Mirra connects">
                {steps.map((s, i) => (
                  <button class="route__tab" role="tab" type="button" id={`tab-${s.id}`} aria-controls="route-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-step={s.id}>
                    {s.label}
                  </button>
                ))}
              </div>
            </div>
            <p class="route__panel" id="route-panel" role="tabpanel" aria-labelledby="tab-mac" aria-live="polite" data-panel>{steps[0].text}</p>
          </div>
        </div>
      </main>

      <section class="sheet" id="overview" aria-labelledby="overview-title">
        <h2 id="overview-title" class="visually-hidden">Overview</h2>
        <div class="sheet__grid">
          <figure class="shot">
            <img src={`${base}/img/app-dark.png`} alt="Mirra's home window on macOS with a Connect button that opens Apple's iPhone Mirroring" width="600" height="570" loading="lazy" />
            <figcaption>Mirra&rsquo;s home window. Connect checks the bridge, then opens Apple&rsquo;s iPhone Mirroring.</figcaption>
          </figure>
          <div class="reqs">
            <h2>Before you install</h2>
            <dl>
              <div><dt>Host</dt><dd>Intel x86_64, macOS 26.7.2 (25G332)</dd></div>
              <div><dt>Apple app</dt><dd>iPhone Mirroring 1.6 (98.5)</dd></div>
              <div><dt>Bridge</dt><dd>Jailbroken iPhone with OpenSSH and ldid</dd></div>
              <div><dt>Network</dt><dd>Working AWDL Wi-Fi</dd></div>
              <div><dt>Video</dt><dd>Working H.264 VideoToolbox decoding</dd></div>
            </dl>
            <p>The iPhone you mirror needs no jailbreak. Unsupported host builds are rejected by the compatibility check.</p>
          </div>
        </div>
        <div class="fineprint">
          <p>
            <strong>Experimental.</strong> Independent community project, not affiliated with Apple. It may not work on your
            devices even when the requirements are met.
          </p>
          <a href={`${repo}#compatibility`}>Check compatibility before you install</a>
        </div>
      </section>
    </div>

    <script>
      import { gsap } from 'gsap';
      import Lenis from 'lenis';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const panel = document.querySelector<HTMLElement>('[data-panel]')!;
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-step]')];
      const cards = [...document.querySelectorAll<HTMLButtonElement>('[data-card]')];
      const copy: Record<string, string> = JSON.parse(
        document.getElementById('route-copy')!.textContent || '{}'
      );

      // The wire runs through the route stops; it lights from the Mac up to the selected stop.
      const track = document.querySelector<HTMLElement>('[data-track]')!;
      const wire = document.querySelector<HTMLElement>('[data-wire]')!;
      const spark = document.querySelector<HTMLElement>('[data-spark]')!;
      let current = 0;
      let stops: number[] = [];

      function layoutWire() {
        const t = track.getBoundingClientRect();
        stops = tabs.map((b) => { const r = b.getBoundingClientRect(); return r.left + r.width / 2 - t.left; });
        track.classList.toggle('is-wrapped', tabs[0].offsetTop !== tabs[tabs.length - 1].offsetTop);
        const span = stops[stops.length - 1] - stops[0];
        wire.style.left = stops[0] + 'px';
        wire.style.width = span + 'px';
        wire.style.setProperty('--lit', String(span ? (stops[current] - stops[0]) / span : 0));
      }
      new ResizeObserver(layoutWire).observe(track);
      document.fonts.ready.then(layoutWire);

      // The arrow leaves the laptop's base, runs down the lane left of the lede and hooks into the
      // "Your Mac" stop. Measured from layout boxes, so entrance, bob and parallax don't skew it.
      const stage = document.querySelector<HTMLElement>('[data-stage]')!;
      const arrow = document.querySelector<SVGSVGElement>('[data-arrow]')!;
      const macFloat = document.querySelector<HTMLElement>('.float--mac')!;
      const lede = document.querySelector<HTMLElement>('.lede')!;
      const macTab = document.getElementById('tab-mac')!;

      function offsetIn(el: HTMLElement) {
        let x = 0, y = 0, n: HTMLElement | null = el;
        while (n && n !== stage) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
        return { x, y, w: el.offsetWidth, h: el.offsetHeight };
      }

      function layoutArrow() {
        if (getComputedStyle(arrow).display === 'none') return;
        arrow.setAttribute('viewBox', `0 0 ${stage.offsetWidth} ${stage.offsetHeight}`);
        const m = offsetIn(macFloat), l = offsetIn(lede), t = offsetIn(macTab);
        const e = { x: t.x - 12, y: t.y + t.h / 2 };
        const lane = Math.min(l.x, t.x) - 34;
        // a point under the laptop's base, carried through the card's -11deg tilt, never right of the lane
        const a = (-11 * Math.PI) / 180, cx = m.x + m.w / 2, cy = m.y + m.h / 2, ly = 0.5 * m.h + 22;
        const lx = Math.min(0.16 * m.w, (lane + 8 - cx + ly * Math.sin(a)) / Math.cos(a));
        const s = { x: cx + lx * Math.cos(a) - ly * Math.sin(a), y: cy + lx * Math.sin(a) + ly * Math.cos(a) };
        const mid = { x: lane, y: (l.y + l.y + l.h) / 2 };
        const shaft = `M${s.x},${s.y} C${s.x + 6},${s.y + 30} ${lane + 4},${mid.y - 36} ${mid.x},${mid.y} S${lane - 6},${e.y - 2} ${e.x},${e.y}`;
        // the head follows the incoming tangent (from the last control point toward the tip)
        const ang = Math.atan2(e.y - (e.y - 2), e.x - (lane - 6)), k = 15, spread = 0.62;
        const p = (d: number) => `${e.x - k * Math.cos(ang + d)},${e.y - k * Math.sin(ang + d)}`;
        arrow.querySelector('[data-arrow-shaft]')!.setAttribute('d', shaft);
        arrow.querySelector('[data-arrow-head]')!.setAttribute('d', `M${p(-spread)} L${e.x},${e.y} L${p(spread)}`);
      }
      new ResizeObserver(layoutArrow).observe(stage);
      document.fonts.ready.then(layoutArrow);
      layoutArrow();

      function travel(to: number) {
        const from = current;
        current = to;
        const span = stops[stops.length - 1] - stops[0];
        const lit = span ? (stops[to] - stops[0]) / span : 0;
        if (reduce || from === to || track.classList.contains('is-wrapped')) {
          wire.style.setProperty('--lit', String(lit));
          return;
        }
        const dur = 0.35 + Math.abs(to - from) * 0.12;
        gsap.to(wire, { '--lit': lit, duration: dur, ease: 'expo.out', overwrite: true });
        gsap.fromTo(spark,
          { x: stops[from] - stops[0], opacity: 1, scale: 1 },
          { x: stops[to] - stops[0], duration: dur, ease: 'power3.inOut', overwrite: true,
            onComplete: () => { gsap.to(spark, { scale: 2.4, opacity: 0, duration: 0.4, ease: 'expo.out' }); } });
      }

      function select(id: string) {
        travel(tabs.findIndex((t) => t.dataset.step === id));
        tabs.forEach((t) => t.tabIndex = t.dataset.step === id ? 0 : -1);
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.step === id)));
        cards.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.card === id)));
        panel.setAttribute('aria-labelledby', 'tab-' + id);
        const r = panel.getBoundingClientRect();
        if (r.bottom > innerHeight || r.top < 0) panel.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
        if (reduce) {
          panel.textContent = copy[id];
          return;
        }
        gsap.to(panel, {
          opacity: 0, y: 6, duration: 0.12, ease: 'power2.in', overwrite: true,
          onComplete: () => {
            panel.textContent = copy[id];
            gsap.to(panel, { opacity: 1, y: 0, duration: 0.45, ease: 'expo.out' });
          },
        });
      }

      tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.step!)));
      cards.forEach((c) => c.addEventListener('click', () => select(c.dataset.card!)));
      tabs.forEach((t, i) =>
        t.addEventListener('keydown', (e) => {
          const moves: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
          if (!(e.key in moves)) return;
          e.preventDefault();
          const next = tabs[(moves[e.key] + tabs.length) % tabs.length];
          next.focus();
          select(next.dataset.step!);
        })
      );

      if (!reduce) {
        const lenis = new Lenis();
        gsap.ticker.add((t) => lenis.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);

        // The arrow is the route's first hop, drawn out of the Mac: the shaft sketches from the laptop,
        // then the head flicks on. Touching the Mac wipes it forward and sketches it again.
        const shaft = document.querySelector<SVGPathElement>('[data-arrow-shaft]')!;
        const head = document.querySelector<SVGPathElement>('[data-arrow-head]')!;
        function sketch(d = 0.6) {
          return gsap.timeline()
            .set([shaft, head], { attr: { 'stroke-dashoffset': 101 } })
            .to(shaft, { attr: { 'stroke-dashoffset': 0 }, duration: d, ease: 'power2.inOut' })
            .to(head, { attr: { 'stroke-dashoffset': 0 }, duration: d * 0.35, ease: 'power3.out' }, '-=0.06');
        }
        let retrace: gsap.core.Timeline | null = null;
        function wipeAndSketch() {
          if (retrace?.isActive() || tl.isActive()) return;
          retrace = gsap.timeline()
            .to([shaft, head], { attr: { 'stroke-dashoffset': -101 }, duration: 0.26, ease: 'power2.in', stagger: 0.04 })
            .add(sketch(0.55));
        }
        const mac = document.querySelector<HTMLElement>('[data-card="mac"]')!;
        mac.addEventListener('pointerenter', wipeAndSketch);
        mac.addEventListener('focus', wipeAndSketch);

        gsap.set([shaft, head], { attr: { 'stroke-dashoffset': 101 } });
        const tl = gsap.timeline({ defaults: { ease: 'expo.out' }, onComplete: () => document.querySelector('.display')!.classList.add('is-settled') });
        // Focal moment: the iPhone line rises, then HACKINTOSH is stamped letter by letter (each lands
        // flat and its extruded depth rises out of the page), then the "On your" sticker slaps on.
        const stamp = '[data-line="c"] .display__char';
        tl.from('[data-line="a"]', { yPercent: 40, opacity: 0, duration: 1 })
          .from(stamp, { scale: 1.4, opacity: 0, duration: 0.28, ease: 'power4.in', stagger: 0.045, clearProps: 'transform,opacity' }, 0.2)
          .fromTo(stamp, { '--d': 0 }, { '--d': 1, duration: 0.75, stagger: 0.045, clearProps: '--d' }, 0.48)
          .from('[data-sticker]', { scale: 1.7, rotate: -24, opacity: 0, duration: 0.55, ease: 'power4.out', clearProps: 'transform,opacity' }, 1.0)
          .from('.card', { scale: 0.6, opacity: 0, duration: 0.9, stagger: 0.1, clearProps: 'transform,opacity' }, 0.5)
          .add(sketch(0.9), 1.05)
          .from('[data-badge]', { scale: 0.4, opacity: 0, rotate: -40, duration: 1, clearProps: 'transform,opacity' }, 0.75)
          .from('.lede, [data-route]', { y: 16, opacity: 0, duration: 0.8, stagger: 0.08 }, 0.9);

        const bob = gsap.to('[data-float]', {
          y: (i) => (i ? 14 : -14), duration: 3.2, ease: 'sine.inOut', yoyo: true, repeat: -1, stagger: 0.6,
        });

        // idle loops (card bob, badge spin) rest while the hero is out of view
        const hero = document.querySelector<HTMLElement>('.hero')!;
        new IntersectionObserver(([e]) => {
          hero.classList.toggle('is-away', !e.isIntersecting);
          e.isIntersecting ? bob.resume() : bob.pause();
        }).observe(hero);
      }

      // Pointer system: one ticker loop lerps the cursor ring, depth parallax, magnetic pull and the extrude light.
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (!reduce && fine) {
        const ring = document.querySelector<HTMLElement>('[data-cursor]')!;
        const dot = document.querySelector<HTMLElement>('[data-cursor-dot]')!;
        const body = document.body;
        const mouse = { x: innerWidth / 2, y: innerHeight / 2 };
        const ringPos = { x: mouse.x, y: mouse.y };
        let ringScale = 1;
        let pressed = false;
        let seen = false;
        let magnet: HTMLElement | null = null;

        const lines = [...document.querySelectorAll<HTMLElement>('.display__inner')].map((el, i) => ({ el, d: [-5, 9, 16][i] ?? 8 }));
        const cards = [...document.querySelectorAll<HTMLElement>('.card')].map((el, i) => ({ el, d: [-14, 12][i] ?? 10 }));
        const pull = [...document.querySelectorAll<HTMLElement>('.badge, .pill, .route__tab')];
        const pos = new Map<HTMLElement, { x: number; y: number }>();
        const shade = { x: 0.0042, y: 0.0042 };
        const interactive = 'a, button, [role="tab"]';

        addEventListener('pointermove', (e) => {
          mouse.x = e.clientX; mouse.y = e.clientY;
          if (!seen) { seen = true; ringPos.x = mouse.x; ringPos.y = mouse.y; ring.classList.add('is-on'); dot.classList.add('is-on'); }
          const t = e.target as Element;
          const link = t.closest(interactive) as HTMLElement | null;
          const onSheet = !!t.closest('.sheet');
          ring.classList.toggle('is-link', !!link);
          ring.classList.toggle('is-sheet', onSheet);
          dot.classList.toggle('is-sheet', onSheet);
          ring.textContent = t.closest('[data-badge]') ? 'Get' : '';
          magnet = link && link.matches('.badge, .pill, .route__tab') ? link : null;
        });
        document.documentElement.addEventListener('pointerleave', () => { seen = false; ring.classList.remove('is-on'); dot.classList.remove('is-on'); });
        addEventListener('pointerdown', () => { pressed = true; });
        addEventListener('pointerup', () => { pressed = false; });

        const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
        gsap.ticker.add(() => {
          ringPos.x = lerp(ringPos.x, mouse.x, 0.16);
          ringPos.y = lerp(ringPos.y, mouse.y, 0.16);
          const target = pressed ? 0.7 : ring.classList.contains('is-link') ? (ring.textContent ? 2.2 : 1.6) : 1;
          ringScale = lerp(ringScale, target, 0.2);
          ring.style.transform = `translate(${ringPos.x}px, ${ringPos.y}px) scale(${ringScale.toFixed(3)})`;
          dot.style.transform = `translate(${mouse.x}px, ${mouse.y}px)`;

          const nx = (mouse.x / innerWidth) * 2 - 1;
          const ny = (mouse.y / innerHeight) * 2 - 1;

          [...lines, ...cards].forEach(({ el, d }) => {
            const s = pos.get(el) ?? { x: 0, y: 0 };
            s.x = lerp(s.x, nx * d, 0.07);
            s.y = lerp(s.y, ny * d * 0.6, 0.07);
            pos.set(el, s);
            el.style.setProperty('--tx', s.x.toFixed(2) + 'px');
            el.style.setProperty('--ty', s.y.toFixed(2) + 'px');
          });

          // magnetic pull: the hovered control leans toward the pointer, the others settle back
          pull.forEach((el) => {
            const m = pos.get(el) ?? { x: 0, y: 0 };
            let tx = 0, ty = 0;
            if (el === magnet) {
              const r = el.getBoundingClientRect();
              tx = (mouse.x - (r.left + r.width / 2)) * 0.28;
              ty = (mouse.y - (r.top + r.height / 2)) * 0.28;
            }
            m.x = lerp(m.x, tx, 0.18);
            m.y = lerp(m.y, ty, 0.18);
            pos.set(el, m);
            el.style.setProperty('--tx', m.x.toFixed(2) + 'px');
            el.style.setProperty('--ty', m.y.toFixed(2) + 'px');
          });

          // the extrude's light follows the pointer: depth falls away from it
          shade.x = lerp(shade.x, 0.0042 - nx * 0.003, 0.08);
          shade.y = lerp(shade.y, 0.0042 - ny * 0.0024, 0.08);
          body.style.setProperty('--sx', shade.x.toFixed(5) + 'em');
          body.style.setProperty('--sy', shade.y.toFixed(5) + 'em');
        });
      }
    </script>
    <script type="application/json" id="route-copy" set:html={JSON.stringify(Object.fromEntries(steps.map((s) => [s.id, s.text])))} />
  </body>
</html>
